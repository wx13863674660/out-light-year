# ========== 「我们的光年」环境变量示例 ==========
# 复制本文件为 .env 并按需修改；敏感信息严禁硬编码进代码
# 说明：Vite 中所有以 VITE_ 开头的变量会注入前端构建产物，
# 生产环境请在部署平台（Vercel/Netlify）的环境变量面板中配置。

# 默认进入密码（Phase 6 支持在"我的"页修改）
# 注意：接入 Supabase/Firebase 后，密码应在服务端使用 bcrypt 哈希存储校验
VITE_APP_DEFAULT_PASSWORD=1314

# 在一起的日子（恋爱计时器起点，格式 YYYY-MM-DD）
VITE_APP_START_DATE=2024-02-14

# 背景音乐地址（可选，留空则隐藏顶部音乐开关按钮）
VITE_APP_MUSIC_URL=

# ========== Firebase（Phase 5 接入后填写）==========
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
